{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site footer",
  "type": "object",
  "required": ["site"],
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "footer": { "type": "string", "description": "The line at the bottom of every page: site.globals.footer" },
        "author": {
          "type": "object",
          "description": "Who the site is by, linked after the line: site.globals.author",
          "required": ["name", "href"],
          "properties": {
            "name": { "type": "string", "description": "The link's text" },
            "href": { "type": "string", "description": "Where it links" },
            "location": { "type": "string", "description": "Where the author is, after the link: \"Vienna, Austria\"" }
          }
        },
        "sponsor": {
          "type": "object",
          "description": "Where to sponsor the project: \"Sponsor\" among the footer's links",
          "required": ["href"],
          "properties": {
            "href": { "type": "string", "description": "The sponsor page's address" }
          }
        }
      }
    }
  }
}
