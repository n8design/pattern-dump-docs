<section class="page-map" aria-label="All pages">
  {{#each nav}}{{#if (eq route "/guide/")}}{{#if children.length}}
  <div class="page-map-group page-map-guide" data-xray="organisms/page-map">
    <h2 class="page-map-title">{{title}}</h2>
    {{#if description}}<p class="page-map-note">{{description}}</p>{{/if}}
    <ol class="page-map-steps" role="list">
      {{#each children}}
      <li class="page-map-step"><a class="page-map-step-link" href="{{route}}"><span class="page-map-step-number" aria-hidden="true"></span><span class="page-map-step-text"><span class="page-map-step-title">{{title}}</span>{{#if description}}<span class="page-map-step-description">{{description}}</span>{{/if}}</span></a></li>
      {{/each}}
    </ol>
  </div>
  {{/if}}{{/if}}{{/each}}
  <div class="page-map-side">
    {{#each nav}}{{#if children.length}}{{#unless (eq route "/guide/")}}
    <div class="page-map-group" data-xray="organisms/page-map">
      <h2 class="page-map-title">{{title}}</h2>
      {{#if description}}<p class="page-map-note">{{description}}</p>{{/if}}
      <ul class="page-map-list" role="list">
        {{#each children}}{{#if (lt @index 3)}}<li><a href="{{route}}">{{title}}</a></li>{{/if}}{{/each}}
      </ul>
    </div>
    {{/unless}}{{/if}}{{/each}}
    <div class="page-map-group" data-xray="organisms/page-map">
      <h2 class="page-map-title">Pages</h2>
      <p class="page-map-note">Everything else.</p>
      <ul class="page-map-list" role="list">
        {{#each nav}}{{#unless children.length}}{{#unless (eq route "/")}}<li><a href="{{route}}">{{title}}</a></li>{{/unless}}{{/unless}}{{/each}}
      </ul>
    </div>
    {{#if body}}{{#if bodyTitle}}<section class="page-map-body" aria-labelledby="page-map-body-title"><h2 id="page-map-body-title">{{bodyTitle}}</h2>{{#if bodyNote}}<p>{{bodyNote}}</p>{{/if}}{{{body}}}</section>{{else if page.headings.[0]}}<section class="page-map-body" aria-labelledby="{{page.headings.[0].anchor}}">{{{body}}}</section>{{else}}<div class="page-map-body">{{{body}}}</div>{{/if}}{{/if}}
  </div>
</section>
