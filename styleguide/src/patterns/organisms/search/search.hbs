<search class="search" data-search data-xray="organisms/search">
  <form class="search-form" method="get">
    <label class="search-label" for="search-input">{{#if label}}{{label}}{{else}}Search this site{{/if}}</label>
    <div class="search-row">
      <input class="search-input" id="search-input" type="search" name="q" autocomplete="off" spellcheck="false">
      {{> atoms-button label="Search" variant="primary" type="submit" }}
    </div>
  </form>
  <p class="search-status" role="status" data-search-status></p>
  <ol class="search-results" data-search-results></ol>
  <noscript><p class="search-status">Search needs JavaScript. Every page is in the navigation above.</p></noscript>
</search>
