<header class="site-header" data-xray="organisms/site-header">
  <a class="site-title" href="/"><svg class="site-logo" aria-hidden="true" focusable="false" viewBox="0 0 699.52 699"><path d="M524.47,396.31l65.53-244.58-69.88-18.72-28.09,104.82c-23.32-29.76-56.13-52.49-95.46-63.03-96.49-25.85-195.66,31.41-221.52,127.89h0l-65.54,244.59,69.88,18.72,28.09-104.82c23.32,29.76,56.13,52.49,95.46,63.03,96.49,25.85,195.66-31.41,221.52-127.89h0ZM321.67,454.33c-57.89-15.51-92.25-75.02-76.74-132.91,15.51-57.89,75.02-92.25,132.91-76.74,57.89,15.51,92.24,75.01,76.74,132.9h0c-15.51,57.9-75.02,92.26-132.91,76.74Z"></path></svg>{{site.title}}</a>
  <button class="site-menu-button" type="button" data-xray="organisms/site-header" popovertarget="site-menu" aria-label="Menu"><svg class="site-menu-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path class="site-menu-icon-open" d="M4 6h16M4 12h16M4 18h16"></path><path class="site-menu-icon-close" d="M6 6l12 12M18 6L6 18"></path></svg></button>
  <div class="site-menu" id="site-menu" popover="auto">
    {{> molecules-site-nav }}
    {{#if site.repository}}<a class="site-header-link" href="{{site.repository.href}}">GitHub</a>{{/if}}
    <search class="site-search" data-xray="organisms/site-header">
      <form class="site-search-form" action="/search/" method="get">
        <label class="site-search-label" for="site-search-input">Search the docs</label>
        <svg class="site-search-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <input class="site-search-input" id="site-search-input" type="search" name="q" placeholder="Search" autocomplete="off">
        <kbd class="site-search-key" aria-hidden="true" data-search-key></kbd>
      </form>
    </search>
  </div>
</header>
