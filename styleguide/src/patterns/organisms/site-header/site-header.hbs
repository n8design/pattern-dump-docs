<header class="site-header" data-xray="organisms/site-header">
  <a class="site-title" href="/"><svg class="site-logo" aria-hidden="true" focusable="false" viewBox="0 0 699.52 699"><path d="M524.47,396.31l65.53-244.58-69.88-18.72-28.09,104.82c-23.32-29.76-56.13-52.49-95.46-63.03-96.49-25.85-195.66,31.41-221.52,127.89h0l-65.54,244.59,69.88,18.72,28.09-104.82c23.32,29.76,56.13,52.49,95.46,63.03,96.49,25.85,195.66-31.41,221.52-127.89h0ZM321.67,454.33c-57.89-15.51-92.25-75.02-76.74-132.91,15.51-57.89,75.02-92.25,132.91-76.74,57.89,15.51,92.24,75.01,76.74,132.9h0c-15.51,57.9-75.02,92.26-132.91,76.74Z"></path></svg><span class="site-title-name">{{site.title}}</span></a>
  <button class="site-menu-button" type="button" data-xray="organisms/site-header" popovertarget="site-menu" aria-label="Menu"><svg class="site-menu-icon" aria-hidden="true" focusable="false" viewBox="0 0 256 256" fill="currentColor"><path class="site-menu-icon-open" d="M228,128a12,12,0,0,1-12,12H40a12,12,0,0,1,0-24H216A12,12,0,0,1,228,128ZM40,76H216a12,12,0,0,0,0-24H40a12,12,0,0,0,0,24ZM216,180H40a12,12,0,0,0,0,24H216a12,12,0,0,0,0-24Z"></path><path class="site-menu-icon-close" d="M208.49,191.51a12,12,0,0,1-17,17L128,145,64.49,208.49a12,12,0,0,1-17-17L111,128,47.51,64.49a12,12,0,0,1,17-17L128,111l63.51-63.52a12,12,0,0,1,17,17L145,128Z"></path></svg></button>
  <div class="site-menu" id="site-menu" popover="auto">
    {{> molecules-site-nav }}
    {{#if site.repository}}<a class="site-header-link" href="{{site.repository.href}}">GitHub</a>{{/if}}
    <search class="site-search" data-xray="organisms/site-header">
      <form class="site-search-form" action="/search/" method="get">
        <label class="site-search-label" for="site-search-input">Search the docs</label>
        <svg class="site-search-icon" aria-hidden="true" focusable="false" viewBox="0 0 256 256" fill="currentColor"><path d="M232.49,215.51,185,168a92.12,92.12,0,1,0-17,17l47.53,47.54a12,12,0,0,0,17-17ZM44,112a68,68,0,1,1,68,68A68.07,68.07,0,0,1,44,112Z"></path></svg>
        <input class="site-search-input" id="site-search-input" type="search" name="q" placeholder="Search" autocomplete="off">
        <kbd class="site-search-key" aria-hidden="true" data-search-key></kbd>
      </form>
    </search>
  </div>
  <div class="site-menu-glass" aria-hidden="true"></div>
</header>
