{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site header",
  "type": "object",
  "required": [
    "site",
    "nav"
  ],
  "properties": {
    "site": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "The site's name, linking to the home page"
        },
        "repository": {
          "type": "object",
          "description": "The project's code repository: a GitHub link in the header",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "type": "string",
              "description": "The repository's address"
            }
          }
        }
      }
    },
    "nav": {
      "type": "array",
      "description": "The navigation, passed on to molecules/site-nav"
    }
  }
}
