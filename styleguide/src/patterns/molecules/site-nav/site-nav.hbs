<nav class="site-nav" aria-label="Site" data-xray="molecules/site-nav">
  <ul class="site-nav-list">
    {{!-- Home is left out: the site title links there, and nav: false on the root index.md would leave out every page.
    Credits and Search stay out with nav: false in their own frontmatter. --}}
    {{#each nav}}{{#unless (eq route "/")}}
    <li class="site-nav-item"><a class="site-nav-link" href="{{route}}"{{#if current}} aria-current="page"{{else}}{{#each children}}{{#if current}} aria-current="true"{{/if}}{{/each}}{{/if}}>{{title}}</a></li>
    {{/unless}}{{/each}}
  </ul>
</nav>
