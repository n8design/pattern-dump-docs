{{#> pages-frame }}
<div class="reading">
  {{> molecules-guide-progress }}
  <div class="reading-row">
    <article class="reading-article">
      {{#unless (onGuideStep nav)}}{{#if page.breadcrumbs.length}}{{> molecules-breadcrumbs }}{{/if}}{{/unless}}
      <h1 class="page-title">{{title}}</h1>
      {{#if (or liveSite (or repository styleGuide))}}<ul class="page-links" role="list">{{#if liveSite}}<li><a href="{{liveSite}}">Live site</a></li>{{/if}}{{#if repository}}<li><a href="{{repository}}">Repository</a></li>{{/if}}{{#if styleGuide}}<li><a href="{{styleGuide}}">Style guide</a></li>{{/if}}</ul>{{/if}}
      {{#if description}}<p class="page-description">{{description}}</p>{{/if}}
      <div class="page-body">{{{body}}}</div>
      {{> molecules-pager }}
    </article>
    {{#if (or page.regions.sidebar page.section)}}<div class="reading-aside">{{{page.regions.sidebar}}}{{> molecules-section-nav }}</div>{{/if}}
  </div>
</div>
{{/pages-frame}}
