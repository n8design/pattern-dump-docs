<dl>
  <dt><code>outDir</code></dt>
  <dd>A string.</dd>
  <dd>The only required top-level key.</dd>
  <dt><code>sourceDir</code></dt>
  <dd>A string. Default <code>./src</code>.</dd>
  <dt><code>build.audit</code></dt>
  <dd><p>True or false. Default <code>true</code>.</p></dd>
  <dd><p><code>--no-audit</code> leaves the audit out.</p></dd>
  <dd><p><code>--audit</code> puts it back in over <code>build.audit: false</code>.</p></dd>
</dl>
