<div class="site-card" data-xray="components/site-card">
  <h{{#if level}}{{level}}{{else}}3{{/if}} class="site-card-name">{{title}}</h{{#if level}}{{level}}{{else}}3{{/if}}>
  {{pd-image image alt=alt}}
  <p class="site-card-line">{{line}}</p>
  <a class="site-card-link" href="{{href}}">{{linkLabel}}</a>
</div>
