{
  "customSyntax": "postcss-scss",
  "rules": {
    "unit-disallowed-list": [
      "px"
    ],
    "property-disallowed-list": [
      "backdrop-filter",
      "-webkit-backdrop-filter"
    ],
    "declaration-property-value-disallowed-list": {
      "box-shadow": [
        "/.*/"
      ],
      "border-radius": [
        "/.*/"
      ],
      "/^border-.*-radius$/": [
        "/.*/"
      ],
      "/^background/": [
        "/gradient/"
      ]
    }
  }
}
