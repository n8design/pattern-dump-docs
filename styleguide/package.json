{
  "name": "@pattern-dump-docs/styleguide",
  "version": "0.1.0",
  "private": true,
  "description": "The style guide: patterns, skin, styles and themes, packaged as a pattern package that the site installs.",
  "type": "module",
  "files": [
    "src/patterns",
    "src/styles",
    "src/scripts",
    "src/helpers",
    "themes",
    "assets"
  ],
  "patternDump": {
    "patterns": "src/patterns",
    "styles": {
      "dir": "src/styles",
      "documentBase": [
        "base"
      ]
    },
    "themes": {
      "dir": "themes",
      "default": "system",
      "switch": "attribute"
    },
    "scripts": "src/scripts",
    "helpers": "src/helpers",
    "assets": [
      "assets"
    ]
  },
  "scripts": {
    "lint:css": "stylelint \"src/styles/**/*.scss\" \"themes/**/*.scss\"",
    "dev": "pd dev --port 4300",
    "audit": "pd audit",
    "typecheck": "tsc --noEmit",
    "build:scripts": "tsc",
    "build": "pd build"
  },
  "devDependencies": {
    "pattern-dump": "0.10.0",
    "postcss-scss": "4.0.9",
    "stylelint": "17.16.0",
    "typescript": "^5.9.0"
  }
}
